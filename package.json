{
  "name": "test-kit-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint test --max-warnings 0 && eslint --no-ignore --max-warnings 0 vitest.config.ts vitest.mutation.config.ts && npm run lint --workspaces --if-present",
    "format": "prettier --write \"packages/**/*.ts\" \"examples/**/*.ts\" \"test/**/*.ts\" \"vitest.config.ts\" \"vitest.mutation.config.ts\"",
    "clean": "tsc --build --clean && rimraf packages/*/dist",
    "format:check": "prettier --check \"packages/**/*.ts\" \"examples/**/*.ts\" \"test/**/*.ts\" \"vitest.config.ts\" \"vitest.mutation.config.ts\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "test:mutation": "bash scripts/mutation-package.sh",
    "test:mutation:changed": "bash scripts/mutation-incremental.sh",
    "crap": "rm -f .stryker-package && vitest run --config vitest.mutation.config.ts --coverage --coverage.provider istanbul --coverage.reporter json --coverage.reporter text && node scripts/crap-report.js",
    "crap:changed": "bash scripts/crap-changed.sh",
    "sync-agent-skills": "./scripts/sync-agent-skills.sh",
    "check-agent-skills": "./scripts/check-agent-skills.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.1091.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/testing": "^11.1.19",
    "@sinonjs/fake-timers": "^11.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testcontainers/mysql": "^12.0.4",
    "@types/node": "^20.0.0",
    "@types/sinonjs__fake-timers": "^8.1.5",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-istanbul": "^3.2.7",
    "eslint": "^8.57.0",
    "expect-type": "^1.1.0",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.23.1",
    "prettier": "^3.4.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.0",
    "rxjs": "^7.8.2",
    "testcontainers": "^12.0.4",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
