{
  "name": "test-kit-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"packages/**/*.ts\" \"examples/**/*.ts\"",
    "clean": "tsc --build --clean && rimraf packages/*/dist",
    "format:check": "prettier --check \"packages/**/*.ts\" \"examples/**/*.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.1091.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/testing": "^11.1.19",
    "@sinonjs/fake-timers": "^11.0.0",
    "@testcontainers/mysql": "^12.0.4",
    "@types/node": "^20.0.0",
    "@types/sinonjs__fake-timers": "^8.1.5",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8.57.0",
    "expect-type": "^1.1.0",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.23.1",
    "prettier": "^3.4.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.0",
    "rxjs": "^7.8.2",
    "testcontainers": "^12.0.4",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
