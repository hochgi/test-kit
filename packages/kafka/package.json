{
  "name": "@hochgi/test-kit-kafka",
  "version": "2.0.2",
  "description": "Probe-driven Kafka producer adapter with an in-memory topic log",
  "keywords": [
    "testing",
    "component-testing",
    "test-double",
    "fake",
    "probe",
    "vitest",
    "typescript"
  ],
  "license": "MIT",
  "author": "Gilad Hoch <giladhoch@gmail.com> (https://github.com/hochgi)",
  "homepage": "https://github.com/hochgi/test-kit/tree/main/packages/kafka#readme",
  "bugs": {
    "url": "https://github.com/hochgi/test-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hochgi/test-kit.git",
    "directory": "packages/kafka"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**/*",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && cp dist/index.d.ts dist/index.d.cts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm --prefix ../core run build && npm run build",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@hochgi/test-kit": "^2.0.0",
    "kafkajs": ">=2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.11.0",
    "kafkajs": "^2.2.4",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.3"
  },
  "main": "./dist/index.cjs"
}
