{
  "name": "@vnatures/test-kit-s3",
  "version": "0.1.0",
  "description": "Disk-backed S3 fake for test-kit component tests",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsc -p ./tsconfig.json",
    "prebuild": "npm run build -w @vnatures/test-kit",
    "pretest": "npm run build -w @vnatures/test-kit",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "prettify": "prettier \"src/**/*.ts\" \"test/**/*.ts\" --write"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vnatures/test-kit": "^0.2.6",
    "mock-aws-s3-v3": "^6.1.13"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3.600.0",
    "@aws-sdk/s3-request-presigner": ">=3.600.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1033.0",
    "@aws-sdk/s3-request-presigner": "^3.1033.0",
    "@types/node": "^20.17.24",
    "@types/jest": "^29.5.14",
    "@vnatures/eslint-config": "^1.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
