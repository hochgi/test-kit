{
  "name": "@hochgi/test-kit-s3",
  "version": "2.0.3",
  "description": "Probe-driven S3 adapter with an in-memory backing",
  "keywords": [
    "testing",
    "component-testing",
    "test-double",
    "fake",
    "probe",
    "vitest",
    "typescript"
  ],
  "license": "MIT",
  "author": "Gilad Hoch <giladhoch@gmail.com> (https://github.com/hochgi)",
  "homepage": "https://github.com/hochgi/test-kit/tree/main/packages/s3#readme",
  "bugs": {
    "url": "https://github.com/hochgi/test-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hochgi/test-kit.git",
    "directory": "packages/s3"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**/*",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && cp dist/index.d.ts dist/index.d.cts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm --prefix ../core run build && npm run build",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@hochgi/test-kit": "^2.0.0",
    "@aws-sdk/client-s3": ">=3.600.0",
    "@aws-sdk/s3-request-presigner": ">=3.600.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1033.0",
    "@aws-sdk/s3-request-presigner": "^3.1033.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8.57.0",
    "prettier": "^3.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0"
  },
  "main": "./dist/index.cjs"
}
