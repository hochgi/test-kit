{
  "name": "@vnatures/test-kit-pg-sequelize",
  "version": "0.1.1",
  "description": "PGlite-backed Sequelize test database for component tests",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsc -p ./tsconfig.json",
    "prebuild": "npm run build -w @vnatures/test-kit",
    "pretest": "npm run build -w @vnatures/test-kit",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "prettify": "prettier \"src/**/*.ts\" \"test/**/*.ts\" --write"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.2",
    "@middle-management/pglite-pg-adapter": "^0.0.4",
    "@vnatures/test-kit": "^0.2.5"
  },
  "peerDependencies": {
    "sequelize": ">=6.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.24",
    "@vnatures/eslint-config": "^1.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "rimraf": "^5.0.5",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
