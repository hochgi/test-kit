{
  "name": "@vnatures/test-kit-pg-sequelize",
  "version": "1.0.1",
  "description": "Probe-driven Sequelize adapter backed by PGlite",
  "license": "UNLICENSED",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm --prefix ../core run build && npm --prefix ../sql run build && npm --prefix ../pglite-driver run build && npm run build",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.2",
    "@middle-management/pglite-pg-adapter": "^0.0.4",
    "@vnatures/test-kit": "^1.0.0",
    "@vnatures/test-kit-pglite-driver": "^1.0.0",
    "@vnatures/test-kit-sql": "^1.0.0"
  },
  "peerDependencies": {
    "sequelize": ">=6.0.0"
  },
  "devDependencies": {
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8.57.0",
    "prettier": "^3.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0"
  },
  "main": "./dist/index.cjs"
}
