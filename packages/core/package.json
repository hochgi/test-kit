{
  "name": "@vnatures/test-kit",
  "version": "0.2.6",
  "description": "Probe-driven component testing utilities",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsc -p ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "prettify": "prettier \"src/**/*.ts\" \"test/**/*.ts\" --write"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/testing": "^11.1.19",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.24",
    "@vnatures/eslint-config": "^1.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
