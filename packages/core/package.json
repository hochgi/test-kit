{
  "name": "@vnatures/test-kit",
  "version": "0.2.0",
  "description": "Probe-driven component testing utilities",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsc -p ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
