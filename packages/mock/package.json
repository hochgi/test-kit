{
  "name": "@vnatures/test-kit-mock",
  "version": "1.0.4",
  "description": "Probe-driven component testing — programmable mock adapters",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/vnatures/test-kit.git",
    "directory": "packages/mock"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build && cp dist/index.d.ts dist/index.d.cts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm --prefix ../core run build && npm run build",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vnatures/test-kit": "^1.0.0"
  },
  "main": "./dist/index.cjs",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8.57.0",
    "prettier": "^3.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/testing": "^11.1.19",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "expect-type": "^1.1.0"
  }
}
