{
  "$schema": "https://opencode.ai/config.json",
  "model": "xai/grok-4.7",
  "small_model": "xai/grok-4.7",
  "provider": {
    "xai": {
      "models": {
        "grok-4.7": {
          "name": "Grok 4.7",
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    }
  },
  "default_agent": "spec-to-ship",
  "skills": {
    "paths": [
      "./.cursor/skills"
    ]
  },
  "agent": {
    "spec-to-ship": {
      "description": "Orchestrates the @hochgi/test-kit spec→ship pipeline. Phase 1 (spec-author) runs in the main thread; phases 2–5 are delegated via task — test-author → coder → reviewer → verifier. Runner is Vitest at the repo root (`npm run check`). Use for any non-trivial change.",
      "mode": "primary",
      "model": "xai/grok-4.7",
      "permission": {
        "task": {
          "*": "deny",
          "spec-author": "allow",
          "test-author": "allow",
          "coder": "allow",
          "reviewer": "allow",
          "verifier": "allow",
          "explore": "allow",
          "general": "allow"
        },
        "question": "allow"
      },
      "variant": "xhigh"
    },
    "build": {
      "model": "xai/grok-4.7",
      "variant": "xhigh"
    }
  }
}
